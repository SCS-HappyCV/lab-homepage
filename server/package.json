{
  "name": "lab-homepage-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/*.test.ts test/**/*.test.ts",
    "db:export": "tsx scripts/export-students.ts",
    "db:import-json": "tsx scripts/import-json.ts",
    "db:migrate-static-photos": "tsx scripts/migrate-static-photos.ts",
    "db:import-patents": "tsx scripts/import-patents.ts",
    "pm2:start": "pm2 start ../ecosystem.config.cjs",
    "pm2:stop": "pm2 stop lab-homepage-api",
    "pm2:restart": "pm2 restart lab-homepage-api",
    "pm2:delete": "pm2 delete lab-homepage-api",
    "pm2:logs": "pm2 logs lab-homepage-api",
    "pm2:status": "pm2 status",
    "update": "./update.sh"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.3",
    "tesseract.js": "^5.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
